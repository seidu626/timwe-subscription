# Base URL of the subscription-external API (no trailing slash).
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# White-label tenant identity used on the unauthenticated auth/catalog routes.
EXPO_PUBLIC_TENANT_KEY=careerify
EXPO_PUBLIC_COUNTRY=GH

# Optional support/legal links shown from Profile. Leave unset to render a
# disabled state instead of a broken link.
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
