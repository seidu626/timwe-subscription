# Production bundle configuration, loaded by Expo CLI when NODE_ENV=production
# (release builds / expo export). Values are baked into the JS bundle.
# The gateway serves the app routes at https://api.nouveauricheglobalgroup.com/v1/app/*.
EXPO_PUBLIC_API_BASE_URL=https://api.nouveauricheglobalgroup.com

# White-label tenant identity used on the unauthenticated auth/catalog routes.
EXPO_PUBLIC_TENANT_KEY=careerify
EXPO_PUBLIC_COUNTRY=GH

# Support/legal links are not yet published; Profile renders a disabled state.
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
