{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hub.local/schemas/post-apply-report.schema.json",
  "title": "Agent-Hub vNext Post-Apply Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "transaction_id", "root", "generated_at", "status", "summary", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"type": "string", "pattern": "^post-apply-[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"},
    "transaction_id": {"type": "string", "minLength": 1},
    "root": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_actions_checked", "settled_safe_actions", "pending_safe_actions", "review_actions_untouched", "blocked_actions_untouched", "errors", "warnings"],
      "properties": {
        "safe_actions_checked": {"type": "integer", "minimum": 0},
        "settled_safe_actions": {"type": "integer", "minimum": 0},
        "pending_safe_actions": {"type": "integer", "minimum": 0},
        "review_actions_untouched": {"type": "integer", "minimum": 0},
        "blocked_actions_untouched": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "kind", "status", "message", "path", "action_id"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^P[0-9]{4}$"},
        "kind": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "warn", "fail"]},
        "message": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "action_id": {"type": ["string", "null"]}
      }
    }
  }
}
