{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hub.local/schemas/run-state.schema.json",
  "title": "Agent-Hub RunState",
  "description": "Mutable runtime state for one execution attempt of a WorkOrder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "work_order_id",
    "goal_id",
    "agent_id",
    "runtime",
    "phase",
    "lease",
    "isolation",
    "metrics",
    "trace_refs",
    "evidence_refs",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "work_order_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model",
        "tier"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "LOW",
            "MED",
            "HIGH"
          ]
        }
      }
    },
    "phase": {
      "type": "string",
      "enum": [
        "queued",
        "claimed",
        "running",
        "blocked",
        "verifying",
        "reviewing",
        "review",
        "failed",
        "done",
        "abandoned"
      ]
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed_by",
        "claimed_at",
        "lease_expires_at",
        "heartbeat_at"
      ],
      "properties": {
        "claimed_by": {
          "type": "string",
          "minLength": 1
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "lease_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "heartbeat_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path",
        "write_locks"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "worktree",
            "sandbox",
            "readonly",
            "manual"
          ]
        },
        "path": {
          "type": "string"
        },
        "write_locks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "tool_calls",
        "duration_ms"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "trace_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "checkpoint": {
      "type": "object",
      "description": "Optional planned-checkpoint marker written when a run exits at a wall-clock budget; used to resume without re-spawning running nodes.",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "created_at",
        "completed_nodes"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "running_nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "paused": {
      "type": "boolean",
      "description": "When true the run is held in andon-pause; no new nodes will be spawned until the andon flag is resolved."
    }
  }
}
