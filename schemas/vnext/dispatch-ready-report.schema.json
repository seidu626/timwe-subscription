{
  "$id": "https://agent-hub/schemas/dispatch-ready-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "claimable_work_order_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "claimable_work_orders": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "findings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "root": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ],
      "type": "string"
    },
    "summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "status",
    "summary",
    "findings"
  ],
  "title": "Agent Hub Dispatch Ready Report",
  "type": "object"
}
