{
  "$id": "https://agent-hub/schemas/runtime-dispatch-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Dispatch Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtimes"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "runtimes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/runtime_profile"
      }
    }
  },
  "$defs": {
    "runtime_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        },
        "dispatch": {
          "$ref": "#/$defs/dispatch"
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "command", "prompt_mode", "launches_process"],
      "properties": {
        "backend": {
          "enum": ["cli", "sdk"],
          "type": "string"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prompt_mode": {
          "enum": ["stdin", "path", "inline"],
          "type": "string"
        },
        "launches_process": {
          "type": "boolean"
        }
      }
    }
  }
}
