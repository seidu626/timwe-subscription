{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hub.local/schemas/subagents/subagent-router-report.schema.json",
  "title": "Agent-Hub Subagent Router Report",
  "description": "Output of the subagent router: which subagents to spawn for a WorkOrder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "work_order_id",
    "recommended_subagents",
    "requires_worktree",
    "use_coop",
    "use_dynamic_workflow"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "route_id": { "type": "string", "minLength": 1 },
    "work_order_id": { "type": "string", "minLength": 1 },
    "recommended_subagents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason", "mode", "risk"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["background", "foreground", "inline"] },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "requires_worktree": { "type": "boolean" },
    "use_coop": { "type": "boolean" },
    "use_dynamic_workflow": { "type": "boolean" }
  }
}
