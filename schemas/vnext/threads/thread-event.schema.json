{
  "$id": "thread-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    },
    "thread_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "thread_id",
    "event_type",
    "created_at",
    "payload"
  ],
  "type": "object"
}
