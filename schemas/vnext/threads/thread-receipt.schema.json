{
  "$id": "thread-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changed_files": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "commands": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "decision": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "followups": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "full_outcome_complete": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "receipt_id": {
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "enum": [
        "done",
        "blocked",
        "failed",
        "needs_review"
      ]
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "role": {
      "enum": [
        "director",
        "pm",
        "scout",
        "worker",
        "verifier",
        "judge"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "thread_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "thread_id",
    "task_id",
    "role",
    "result",
    "summary",
    "evidence_refs",
    "changed_files",
    "commands",
    "risks",
    "followups",
    "created_at"
  ],
  "type": "object"
}
