{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hub.local/schemas/rollback-manifest.schema.json",
  "title": "Agent-Hub vNext Rollback Manifest",
  "description": "Rollback operations emitted by the safe migration applier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rollback_id",
    "transaction_id",
    "plan_id",
    "root",
    "created_at",
    "safe_to_apply",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "rollback_id": {"type": "string", "pattern": "^rollback-[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"},
    "transaction_id": {"type": "string", "pattern": "^migration-txn-[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$"},
    "plan_id": {"type": "string", "minLength": 1},
    "root": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "safe_to_apply": {"type": "boolean"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "operation", "path", "backup_path", "reason"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "enum": ["delete_file", "restore_file"]},
        "path": {"type": "string", "minLength": 1},
        "backup_path": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
