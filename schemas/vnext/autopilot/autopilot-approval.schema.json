{
  "$id": "https://agent-hub/schemas/autopilot/autopilot-approval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autopilot Approval",
  "description": "Records an autopilot approval decision (policy-as-HITL replacement), its authority, and closeout obligations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "decision", "authority_level", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {"type": "string", "minLength": 1},
    "session_id": {"type": ["string", "null"]},
    "decision": {"type": "string", "enum": ["auto_approved", "policy_denied", "multi_runtime_required", "human_required", "hard_stop"]},
    "authority_level": {"type": "string", "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"]},
    "policy_id": {"type": ["string", "null"]},
    "work_order_id": {"type": ["string", "null"]},
    "question_id": {"type": ["string", "null"]},
    "approved_action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string"},
        "paths": {"type": "array", "items": {"type": "string"}},
        "work_order_id": {"type": ["string", "null"]}
      }
    },
    "evidence_required_before_closeout": {"type": "array", "items": {"type": "string"}},
    "rollback_required": {"type": "boolean"},
    "reason": {"type": "string"},
    "created_at": {"type": "string"}
  }
}
