{
  "$id": "https://agent-hub/schemas/autopilot/autopilot-budget.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autopilot Budget",
  "description": "Budget envelope for an autopilot session. When exceeded, the loop checkpoints and pauses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "budget_id": {"type": ["string", "null"]},
    "session_id": {"type": "string", "minLength": 1},
    "max_iters": {"type": ["integer", "null"]},
    "max_runtime_minutes": {"type": ["number", "null"]},
    "max_tokens": {"type": ["integer", "null"]},
    "iters_used": {"type": "integer", "minimum": 0},
    "runtime_minutes_used": {"type": "number", "minimum": 0},
    "tokens_used": {"type": "integer", "minimum": 0},
    "exceeded": {"type": "boolean"},
    "started_at": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]},
    "created_at": {"type": "string"}
  }
}
