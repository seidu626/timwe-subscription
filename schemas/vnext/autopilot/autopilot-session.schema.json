{
  "$id": "https://agent-hub/schemas/autopilot/autopilot-session.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autopilot Session",
  "description": "Mutable run state for one autopilot session. WorkOrder v2 stays immutable; this artifact is the autopilot's RunState.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "status", "authority_ceiling", "mode", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["created", "planning", "running", "paused", "blocked", "escalated", "closed", "idle"]},
    "authority_ceiling": {"type": "string", "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"]},
    "mode": {"type": "string", "enum": ["advisory", "assisted", "autonomous"]},
    "goal_id": {"type": ["string", "null"]},
    "thread_id": {"type": ["string", "null"]},
    "started_by_runtime": {"type": ["string", "null"]},
    "active_phase": {"type": ["string", "null"]},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iters": {"type": ["integer", "null"]},
        "max_runtime_minutes": {"type": ["number", "null"]},
        "max_tokens": {"type": ["integer", "null"]},
        "iters_used": {"type": "integer", "minimum": 0},
        "runtime_minutes_used": {"type": "number", "minimum": 0},
        "tokens_used": {"type": "integer", "minimum": 0},
        "started_at": {"type": ["string", "null"]}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"type": "string"},
          "ref": {"type": "string"}
        }
      }
    },
    "decisions": {"type": "array", "items": {"type": "string"}},
    "questions": {"type": "array", "items": {"type": "string"}},
    "delegations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "runtime"],
        "properties": {
          "task_id": {"type": "string"},
          "runtime": {"type": "string"},
          "role": {"type": "string"},
          "status": {"type": "string"},
          "work_order_id": {"type": ["string", "null"]}
        }
      }
    },
    "escalations": {"type": "array", "items": {"type": "string"}},
    "outcome": {"type": ["string", "null"], "enum": ["pass", "warn", "blocked", "escalated", "idle", "fail", null]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
