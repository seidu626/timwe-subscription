{
  "$id": "https://agent-hub/schemas/external-task.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Agent Hub External Task",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "external_task_id": {
      "type": "string"
    },
    "runtime": {
      "type": "string",
      "enum": ["copilot"]
    },
    "work_order_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "issue_number": {
      "type": ["integer", "null"]
    },
    "issue_url": {
      "type": ["string", "null"]
    },
    "pr_url": {
      "type": ["string", "null"]
    },
    "branch": {
      "type": ["string", "null"]
    },
    "assignee": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": [
        "planned",
        "opened",
        "assigned",
        "in_progress",
        "pr_opened",
        "needs_review",
        "completed",
        "merged",
        "closed",
        "failed"
      ]
    },
    "allowed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "idempotency_key": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "external_task_id",
    "runtime",
    "work_order_id",
    "status",
    "allowed_files",
    "forbidden_files",
    "idempotency_key",
    "evidence_refs"
  ]
}
