{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hub.local/schemas/self-improvement/event.schema.json",
  "title": "Self Improvement Canonical Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "case_id",
    "source_type",
    "source_id",
    "event_type",
    "status",
    "timestamp",
    "actor",
    "summary",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "self_improvement",
        "peer_grill",
        "hvc_work_order",
        "harness_task"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
