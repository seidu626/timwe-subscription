{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hub.local/schemas/self-improvement/case.schema.json",
  "title": "Self Improvement Canonical Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "source_type",
    "source_id",
    "title",
    "status",
    "kind",
    "severity",
    "summary",
    "source_path",
    "timestamps",
    "links",
    "evidence",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "self_improvement",
        "peer_grill",
        "hvc_work_order",
        "harness_task"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "event.schema.json"
      }
    }
  }
}
