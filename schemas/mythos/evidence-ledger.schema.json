{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mythos Evidence Ledger",
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "evidence_type", "status"],
        "properties": {
          "claim": {"type": "string"},
          "evidence_type": {"enum": ["file", "symbol", "route", "schema", "migration", "test", "command", "runtime-log", "manual-observation", "blocked-reason"]},
          "evidence_path_or_command": {"type": "string"},
          "result": {"type": "string"},
          "status": {"enum": ["proved", "refuted", "partial", "blocked", "unknown"]},
          "confidence": {"enum": ["low", "medium", "high"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
