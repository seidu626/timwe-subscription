{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hub.local/schemas/agent-teacher/phase-record.schema.json",
  "title": "Agent Teacher Phase Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "goal_id",
    "goal_state_path",
    "sequence",
    "phase_id",
    "status",
    "input_artifact_handles",
    "output_artifact_handles",
    "previous_artifact_check",
    "summary",
    "ts"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "phase_record" },
    "run_id": { "type": "string", "minLength": 1 },
    "goal_id": { "type": "string", "minLength": 1 },
    "goal_state_path": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "phase_id": {
      "type": "string",
      "enum": ["research", "plan", "execute", "validate"]
    },
    "status": {
      "type": "string",
      "enum": ["passed", "fixed", "failed", "blocked", "not applicable", "not implemented"]
    },
    "input_artifact_handles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "output_artifact_handles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "previous_artifact_check": {
      "type": "string",
      "enum": ["not_applicable", "verified", "skipped"]
    },
    "previous_phase_id": {
      "type": "string",
      "enum": ["research", "plan", "execute", "validate"]
    },
    "previous_output_artifact_handles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "context_handles": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "capsule_id", "path", "summary"],
        "properties": {
          "type": { "type": "string", "const": "ContextCapsule" },
          "capsule_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "goal_current_phase_at_record": {
      "type": "string",
      "minLength": 1
    },
    "skip_reason": {
      "type": "string",
      "minLength": 1
    },
    "summary": { "type": "string", "minLength": 1 },
    "ts": { "type": "string", "minLength": 1 }
  }
}
