{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontend Intent Brief",
  "type": "object",
  "required": [
    "taskId",
    "productGoal",
    "personas",
    "workflows",
    "successCriteria"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "productGoal": {
      "type": "string",
      "minLength": 1
    },
    "problemStatement": {
      "type": "string"
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "successCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
