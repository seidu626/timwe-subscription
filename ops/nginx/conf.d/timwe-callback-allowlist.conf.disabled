# TIMWE Callback Source IP Allowlist
# ===================================
# STATUS: DISABLED — rename to timwe-callback-allowlist.conf to activate.
#
# PURPOSE:
#   Restrict inbound TIMWE notification callbacks on /api/v1/notification/ paths
#   to known TIMWE outbound IP ranges. All other sources receive 403 Forbidden.
#
# ACTIVATION:
#   1. Replace PLACEHOLDER CIDRs below with the authoritative TIMWE outbound ranges.
#   2. Rename this file: mv timwe-callback-allowlist.conf.disabled timwe-callback-allowlist.conf
#   3. Uncomment the include line in he-bootstrap.conf.
#   4. Test: nginx -t
#   5. Reload: nginx -s reload
#
# MAINTENANCE:
#   When TIMWE change their outbound IP ranges, update the geo block below and reload.
#   Coordinate with TIMWE integration team and record changes in the ops runbook.
#
# ============================================
# Geo block: TIMWE outbound callback source IPs
# ============================================
# Maps $remote_addr to $timwe_callback_trusted (1 = allowed, 0 = denied).

geo $timwe_callback_trusted {
    default 0;

    # ============================================
    # PLACEHOLDER: Replace with real TIMWE outbound CIDRs.
    # Obtain from TIMWE integration / partner team.
    # ============================================
    # Example format (do NOT use without confirmation from TIMWE):
    # 203.0.113.0/24    1;   # TIMWE Portugal HQ egress (example)
    # 198.51.100.0/24   1;   # TIMWE platform cluster (example)

    # Local/Docker/staging: allow for integration testing only.
    # Remove or tighten before production go-live.
    127.0.0.1          1;
    10.0.0.0/8         1;
    172.16.0.0/12      1;
    192.168.0.0/16     1;
}

# ============================================
# Location block: enforce allowlist on callback paths
# ============================================
# Place this inside the relevant server {} block, or include it
# into the server block that proxies /api/v1/notification/ paths.
#
# Example usage inside a server block:
#
#   server {
#       ...
#       # TIMWE callback allowlist (activated via include above)
#       location ~ ^/api/v1/notification/ {
#           if ($timwe_callback_trusted = 0) {
#               return 403 "Forbidden: source IP not in TIMWE allowlist";
#           }
#           proxy_pass http://127.0.0.1:8080;  # KrakenD
#       }
#       ...
#   }
#
# NOTE: nginx 'if' inside location is safe for simple return/proxy_pass use.
# If more complex logic is needed, use map + limit_except or allow/deny blocks.
